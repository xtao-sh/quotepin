{
  "name": "review-annotation",
  "version": "0.6.0",
  "private": true,
  "description": "Local document review and annotation desktop app.",
  "author": "XTAO-SH",
  "license": "Apache-2.0",
  "homepage": "https://github.com/XTAO-SH/review-annotation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XTAO-SH/review-annotation.git"
  },
  "bugs": {
    "url": "https://github.com/XTAO-SH/review-annotation/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "api": "node server/index.js",
    "mcp": "node mcp/review-annotation-server.mjs",
    "build:mcp": "node scripts/build-mcp-server.mjs",
    "build": "vite build && npm run build:mcp && node scripts/prepare-license-bundle.mjs",
    "check:public": "node scripts/check-public-tree.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "lint": "eslint .",
    "check:security": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high",
    "verify": "npm run check:public && npm run check:runtime && npm run lint && npm run check:security && npm test && npm run build",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "serve": "npm run build && node server/index.js",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir && node scripts/sign-local-app.mjs",
    "desktop:install": "npm run desktop:pack && node scripts/install-local-app.mjs",
    "desktop:dist": "npm run build && electron-builder",
    "preview": "vite preview --host 127.0.0.1"
  },
  "build": {
    "appId": "tech.taich.review-annotation",
    "productName": "批注工作台",
    "asar": true,
    "asarUnpack": [
      "server/pdf-outline.py",
      "server/annotated-pdf.py",
      "dist-mcp/**/*"
    ],
    "files": [
      "dist/**/*",
      "dist-mcp/**/*",
      "server/**/*",
      "mcp/**/*",
      "electron/**/*",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "TRADEMARKS.md",
      "README.md",
      "requirements.txt",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "hardenedRuntime": true,
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^8.0.0",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "unzipper": "^0.12.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/onest": "^5.2.11",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.1.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "postcss": "8.5.23",
    "tar": "7.5.22",
    "qs": "6.16.0",
    "fast-uri": "3.1.6"
  }
}
